{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "includeEntryExports": true,
  "entry": [
    "src/apiserver/run.ts",
    "src/wsserver/run.ts",
    "src/compiler/glc.ts",
    "src/glidelite/glidelite.ts",
    "src/glidelite/backend/glidelite.ts",
    "src/glidelite/frontend/glidelite.ts",
    "src/glidelite/vite/glidelite.ts"
  ],
  "project": ["src/**"],
  "ignoreExportsUsedInFile": {
    "enum": true,
    "interface": true,
    "type": true
  },
  "ignoreDependencies": [
    "@tsconfig/node-lts",
    "@vitejs/plugin-react",
    "npm",
    "ts-node"
  ]
}
